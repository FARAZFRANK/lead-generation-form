msgstr "E-Mail-Betreffzeile, die den Absendern zugestellt wird. Unterstützt dynamische Merge-Tags."

#: admin/settings.php:2374
msgid "Pre-filled greeting & closing"
msgstr "Vorab ausgefüllte Begrüßung und Abschluss"

#: admin/settings.php:2375
msgid "Rich text with {Name}, {Email}, {Site_Name}, {Form_Name}, {Submission_Date}"
msgstr "Rich-Text mit {Name}, {Email}, {Site_Name}, {Form_Name}, {Submission_Date}"

#: admin/settings.php:2376
msgid "Confirmation email message body delivered to the inquiry submitter with automated brand logo embedding."
msgstr "Bestätigungs-E-Mail-Nachrichtentext, der dem Anfragesteller mit automatischer Einbettung des Markenlogos zugestellt wird."

#: admin/settings.php:2381
msgid "Valid image URL from Media Library"
