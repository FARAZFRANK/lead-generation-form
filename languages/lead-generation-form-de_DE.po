msgstr "Gültige Zeitstempel JJJJ-MM-TT HH:MM"

#: admin/settings.php:2436
msgid "Automated time window during which the form actively accepts visitor inquiries."
msgstr "Automatisiertes Zeitfenster, in dem das Formular Besucheranfragen aktiv entgegennimmt."

#: admin/settings.php:2441
msgid "Positive integer (e.g. 50, 100, 500)"
msgstr "Positive ganze Zahl (z. B. 50, 100, 500)"

