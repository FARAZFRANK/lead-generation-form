msgid "Custom text with {form_name}, {site_title}, {form_id}"
msgstr "Benutzerdefinierter Text mit {form_name}, {site_title}, {form_id}"

#: admin/settings.php:2394
msgid "H1 banner heading rendered at the top of admin lead notification emails."
msgstr "Die Überschrift des H1-Banners wird oben in E-Mails mit Admin-Lead-Benachrichtigungen angezeigt."

#: admin/settings.php:2399
msgid "Any valid HEX color string"
msgstr "Jede gültige HEX-Farbzeichenfolge"

#: admin/settings.php:2400
msgid "Background accent and text color for email header banner and cards."
msgstr "Hintergrundakzent und Textfarbe für E-Mail-Header-Banner und -Karten."

#: admin/settings.php:2406
msgid "Includes a 1-click \"View Lead in Dashboard\" button inside admin notification emails."
msgstr "Enthält eine 1-Klick-Schaltfläche „Lead im Dashboard anzeigen“ in Administrator-Benachrichtigungs-E-Mails."

#: admin/settings.php:2412
msgid "Visual presentation template for frontend submission success alerts."
msgstr "Visuelle Präsentationsvorlage für Benachrichtigungen über den Erfolg der Frontend-Einreichung."

#: admin/settings.php:2418
msgid "Central animated glowing badge icon celebrating successful form submission."
msgstr "Zentrales animiertes, leuchtendes Abzeichen-Symbol zur Feier der erfolgreichen Formularübermittlung."

#: admin/settings.php:2424
msgid "Time elapsed before thank you message smoothly fades out and resets form view."
msgstr "Es vergeht Zeit, bis die Dankesnachricht sanft ausgeblendet wird und die Formularansicht zurückgesetzt wird."

#: admin/settings.php:2429
msgid "Valid HTTPS Webhook Endpoint URL"
msgstr "Gültige HTTPS-Webhook-Endpunkt-URL"

#: admin/settings.php:2430
msgid "Form-level destination for real-time JSON submission payloads (Zapier, Make, n8n)."
msgstr "Ziel auf Formularebene für Echtzeit-JSON-Übermittlungsnutzlasten (Zapier, Make, n8n)."

